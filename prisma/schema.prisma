// Italiano Master · schema del panel de administración
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/* Usuarios de la plataforma: admin (Mkoo) + estudiantes creados/gestionados desde el panel */
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("student") // "admin" | "student"
  displayName  String
  level        String   @default("A1") // MCER
  plan         String   @default("free") // free | pro | premium | platinum
  xp           Int      @default(0)
  streak       Int      @default(0)
  lessonsDone  Int      @default(0)
  wordsInSrs   Int      @default(0)
  active       Boolean  @default(true)
  lastSeen     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/* Configuración key/value: config de la app, overrides de contenido, token admin */
model Setting {
  key   String @id
  value String // JSON
}

/* Telemetría: eventos de uso de la plataforma (para el dashboard admin) */
model TelemetryEvent {
  id        String   @id @default(cuid())
  clientId  String
  username  String?
  event     String // boot | login | lesson_completed | quiz_completed | plan_changed | tutor_message | cert_earned | level_test | admin_action | ...
  detail    String? // JSON pequeño
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event])
}
